# Copy the lines you need into .env.development.local (already git-ignored).

# Base URL of the API. Leave empty in development: requests go to /api and the
# Vite dev server proxies them to http://localhost:4000.
VITE_API_URL=

# Development only. A token from the API's `npm run dev:token -- you@example.com`,
# used until login exists. Ignored in production builds. Never commit a real token.
VITE_DEV_TOKEN=
