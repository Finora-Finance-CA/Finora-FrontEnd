# Copy this file to .env and fill in the values (.env is git-ignored).
# Real values are in the team's credential document.
# Restart `npm run dev` after changing .env; Vite only reads it on startup.

# Every VITE_ value is built into the public JavaScript bundle, so only ever put
# values here that are safe for anyone to see.

# Required in production, empty in development. The API's address, e.g.
# https://finora-api.onrender.com (no /api, no trailing slash needed).
# Leave empty locally: requests go to /api and the Vite dev server proxies them to
# http://localhost:4000 (see vite.config.js).
VITE_API_URL=

# Required. Supabase project URL, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL=

# Required. Supabase publishable key (starts with sb_publishable_). Safe to use in the
# browser; never put the secret/service role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=