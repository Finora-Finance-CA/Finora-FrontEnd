# Copy this file to .env and fill in the values (.env is git-ignored).
# Real values are in the team's credential document.
# Restart `npm run dev` after changing .env; Vite only reads it on startup.

# Base URL of the API. Leave empty in development: requests go to /api and the
# Vite dev server proxies them to http://localhost:4000 (see vite.config.js).
VITE_API_URL=

# Supabase project URL, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_). Safe to use in the
# browser; never put the secret/service role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=